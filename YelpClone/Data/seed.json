  "comments": [
    { "id": "cmt-parks-1", "collectionID": "col-best-parks", "authorName": "picnicpete", "text": "Central Park on a Saturday morning with the farmers market is unbeatable.", "createdAt": "2026-09-20T17:42:00Z" },
    { "id": "cmt-parks-2", "collectionID": "col-best-parks", "authorName": "aggie_alex", "text": "Would add Covell Park, but Slide Hill's sledding hill makes up for it.", "createdAt": "2026-09-28T02:15:00Z" },
    { "id": "cmt-parks-3", "collectionID": "col-best-parks", "authorName": "greenbeltgrace", "text": "Thanks all! Arboretum loop is best around sunset.", "createdAt": "2026-10-02T23:05:00Z" },
    { "id": "cmt-study-1", "collectionID": "col-study-spots", "authorName": "midtermmaya", "text": "Temple has outlets along the back wall if you get there before 10.", "createdAt": "2026-09-15T16:30:00Z" },
    { "id": "cmt-study-2", "collectionID": "col-study-spots", "authorName": "quietcarrel", "text": "Shields 24-hour room during finals week is the real MVP.", "createdAt": "2026-10-06T07:48:00Z" },
    { "id": "cmt-e2e-1", "collectionID": "col-davis-end-to-end", "authorName": "bikeloop_ben", "text": "Did the whole route in one afternoon. Raptor Center closes at 4, plan ahead.", "createdAt": "2026-08-30T21:10:00Z" },
    { "id": "cmt-e2e-2", "collectionID": "col-davis-end-to-end", "authorName": "townandgown", "text": "Added the Bicycling Hall of Fame since you can't do this tour without it.", "createdAt": "2026-09-12T18:00:00Z" },
    { "id": "cmt-e2e-3", "collectionID": "col-davis-end-to-end", "authorName": "sunsetsam", "text": "Wildhorse at the end is a long way out. Worth it for the view though.", "createdAt": "2026-10-04T01:22:00Z" },
    { "id": "cmt-pizza-1", "collectionID": "col-pizza-night", "authorName": "slicehunter", "text": "Woodstock's Tuesday deal is still going strong.", "createdAt": "2026-09-23T03:40:00Z" },
    { "id": "cmt-pizza-2", "collectionID": "col-pizza-night", "authorName": "crustcritic", "text": "Lamppost's ranch is better than their pizza, and I mean that as a compliment.", "createdAt": "2026-10-08T04:12:00Z" },
    { "id": "cmt-burger-1", "collectionID": "col-one-burger", "authorName": "olivedriveonly", "text": "Order the Paula's Pick. Trust me.", "createdAt": "2026-09-05T19:55:00Z" },
    { "id": "cmt-burger-2", "collectionID": "col-one-burger", "authorName": "latenightlee", "text": "Strong opinion, correct opinion.", "createdAt": "2026-09-30T05:30:00Z" },
    { "id": "cmt-date-1", "collectionID": "col-date-night", "authorName": "marigold_m", "text": "Bistro 33's patio then a movie at the Varsity. Perfect night.", "createdAt": "2026-10-03T04:30:00Z" },
    { "id": "cmt-date-2", "collectionID": "col-date-night", "authorName": "twoticketsplease", "text": "Ciocolat closes earlier than you'd think. Do dessert first if you're seeing a late show.", "createdAt": "2026-10-09T02:10:00Z" },
    { "id": "cmt-brunch-1", "collectionID": "col-brunch", "authorName": "sundaysara", "text": "Crepeville's line moves faster than it looks.", "createdAt": "2026-09-27T17:20:00Z" },
    { "id": "cmt-brunch-2", "collectionID": "col-brunch", "authorName": "eggsbenedavis", "text": "Farmers Market pastries count as brunch. I don't make the rules.", "createdAt": "2026-10-11T16:45:00Z" },
    { "id": "cmt-cheap-1", "collectionID": "col-cheap-eats", "authorName": "brokeaggie", "text": "Ali Baba's falafel plate fed me through midterms.", "createdAt": "2026-10-01T20:05:00Z" },
    { "id": "cmt-cheap-2", "collectionID": "col-cheap-eats", "authorName": "bikelane_bo", "text": "Dos Coyotes is a trek from campus but worth it.", "createdAt": "2026-10-07T23:30:00Z" },
    { "id": "cmt-coffee-1", "collectionID": "col-coffee-crawl", "authorName": "decafdan", "text": "Did all five. Did not sleep. Ten out of ten.", "createdAt": "2026-10-05T22:15:00Z" }
  ]
